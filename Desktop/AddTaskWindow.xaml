<Window x:Class="Desktop.AddTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создать задачу" 
        Height="500" 
        Width="400" 
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <StackPanel>
            <Label Content="Название" FontSize="16"/>
            <TextBox x:Name="TitleTextBox" FontSize="14" Padding="5" Margin="0,5,0,15" Height="30"/>

            <Label Content="Категория" FontSize="16"/>
            <ComboBox x:Name="CategoryComboBox" FontSize="14" Padding="5" Margin="0,5,0,15" Height="30">
                <ComboBoxItem Content="Дом"/>
                <ComboBoxItem Content="Работа"/>
                <ComboBoxItem Content="Учеба"/>
                <ComboBoxItem Content="Отдых"/>
            </ComboBox>

            <Label Content="Описание" FontSize="16"/>
            <TextBox x:Name="DescriptionTextBox" FontSize="14" Padding="5" Margin="0,5,0,15" Height="60" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,30" HorizontalAlignment="Center">
                <StackPanel Width="140">
                    <Label Content="Дата" FontSize="16"/>
                    <DatePicker x:Name="DatePicker" FontSize="14" Padding="5" Height="30"/>
                </StackPanel>

                <StackPanel Width="20"/>

                <StackPanel Width="140">
                    <Label Content="Время" FontSize="16"/>
                    <ComboBox x:Name="TimePicker" FontSize="14" Padding="5" Height="30">
                        <ComboBoxItem Content="9:00am"/>
                        <ComboBoxItem Content="10:00am"/>
                        <ComboBoxItem Content="11:00am"/>
                        <ComboBoxItem Content="12:00pm"/>
                        <ComboBoxItem Content="1:00pm"/>
                        <ComboBoxItem Content="2:00pm"/>
                        <ComboBoxItem Content="3:00pm"/>
                        <ComboBoxItem Content="4:00pm"/>
                        <ComboBoxItem Content="5:00pm"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Создать" Click="CreateButton_Click" 
        FontSize="16" Width="150" Height="35" Margin="0,0,20,0"
        Background="#FFFF5050" Foreground="White" BorderBrush="{x:Null}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="Отмена" Click="CancelButton_Click" 
        FontSize="16" Width="150" Height="35"
        Background="LightGray" Foreground="Black" BorderBrush="{x:Null}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>