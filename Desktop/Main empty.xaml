<Window x:Class="Desktop.Main_empty"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Desktop"
        mc:Ignorable="d"
        Title="Main_empty" Height="600" Width="800" WindowStartupLocation="CenterScreen">
    <Grid>
        
        <Menu Margin="-180,1,803,433">
            <StackPanel Margin="10,10,0,0">
                <Button Content="Выход" Margin="0,0,0,10" HorizontalAlignment="Left" FontSize="20" BorderBrush="{x:Null}" Background="{x:Null}" Foreground="Black"/>
                <Button Content="Изменить&#xD;&#xA;фото&#xD;&#xA;профиля" HorizontalAlignment="Left" FontSize="20" BorderBrush="{x:Null}" Background="{x:Null}" Foreground="Black" Click="Button_Click"/>
            </StackPanel>
        </Menu>
        <StackPanel Margin="0,0,0,465">
            <Image HorizontalAlignment="Left" Height="80" Margin="10,10,0,0" VerticalAlignment="Top" Width="80" Source="/ForMenu.png"/>
        </StackPanel>

        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="145,108,0,0" Height="184">
            <TextBlock Text="Добро пожаловать!" 
                      FontSize="40" 
                      HorizontalAlignment="Left"
                      Margin="0,0,0,20"/>
            <TextBlock 
                      FontSize="40" Height="110"
                      ><Run Text="Создайте свою первую"/><LineBreak/><Run Text="задачу!"/></TextBlock>
        </StackPanel>

            <StackPanel Margin="145,340,228,159">
            <Button Content="Создать первую задачу" Click="CreateFirstTaskButton_Click" HorizontalAlignment="Right" FontSize="20" Width="250" Height="45" BorderBrush="{x:Null}" Background="#FFFF5050" Foreground="White">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>
                
        </StackPanel>


         <Button Content="Вернуться к регистрации" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="70,0,0,106" FontSize="16" Width="180" Height="35" Click="BackToRegistration_Click"/> 



    </Grid>
</Window>
