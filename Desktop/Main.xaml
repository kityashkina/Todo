<Window x:Class="Desktop.Main"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Desktop"
        mc:Ignorable="d"
        Title="Main" Height="600" Width="800" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Background="White" Height="100">
            <Image Height="80" Width="80" Margin="10,10,0,10" Source="/ForMenu.png"/>
            <Button Content="Дом" Margin="50,0,0,0" VerticalAlignment="Center" Background="{x:Null}" Foreground="#FF2CCE00" BorderBrush="{x:Null}" FontSize="18"/>
            <Button Content="Работа" Margin="20,0,0,0" VerticalAlignment="Center" Background="{x:Null}" Foreground="#FFFF7500" BorderBrush="{x:Null}" FontSize="18"/>
            <Button Content="Учеба" Margin="20,0,0,0" VerticalAlignment="Center" Background="{x:Null}" Foreground="#FF0045CE" BorderBrush="{x:Null}" FontSize="18"/>
            <Button Content="Отдых" Margin="20,0,0,0" VerticalAlignment="Center" Background="{x:Null}" Foreground="#FFBA00CE" BorderBrush="{x:Null}" FontSize="18"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Width="150">
            <TextBlock x:Name="UserNameText" Text="Alex" Margin="20,20,0,0" FontSize="18"/>
            <Button Content="Задачи" Click="TasksButton_Click" Margin="20,30,0,0" Background="{x:Null}" BorderBrush="{x:Null}" FontSize="18" HorizontalAlignment="Left"/>
            <Button Content="История" Margin="20,10,0,0" Background="{x:Null}" BorderBrush="{x:Null}" FontSize="18" HorizontalAlignment="Left" Click="HistoryButton_Click"/>
            <Button Content="+" Margin="20,200,20,0" Click="AddTaskButton_Click" Height="70" Width="70" Foreground="White" FontSize="24" BorderBrush="{x:Null}" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFFF5050">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="50"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>

        <!-- Список задач -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="10">
            <StackPanel x:Name="TasksPanel">

                <!-- Задача 1 -->
                <Border MouseLeftButtonDown="Task_Click" BorderBrush="Black" BorderThickness="1" CornerRadius="10" Background="White" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Margin="15">
                        <CheckBox x:Name="TemplateCheckBox" VerticalAlignment="Center" Margin="0,0,15,0" Click="CheckBox_Click">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#FF0090FF"/>
                                    <Setter Property="BorderThickness" Value="3"/>
                                    <Style.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="50"/>
                                        </Style>
                                    </Style.Resources>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="#FFFF5050"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>

                        <!-- Название и дата -->
                        <StackPanel>
                            <TextBlock Text="Go fishing with Stephen" FontSize="16"/>
                            <TextBlock Text="09:00am" FontSize="14" Foreground="Gray"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Задача 2 -->
                <Border MouseLeftButtonDown="Task_Click" BorderBrush="Black" BorderThickness="1" CornerRadius="10" Background="White" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Margin="15">
                        <CheckBox VerticalAlignment="Center" Margin="0,0,15,0" Click="CheckBox_Click">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#FF0090FF"/>
                                    <Setter Property="BorderThickness" Value="3"/>
                                    <Style.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="50"/>
                                        </Style>
                                    </Style.Resources>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="#FFFF5050"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>

                        <!-- Название и дата -->
                        <StackPanel>
                            <TextBlock Text="Go fishing with Stephen" FontSize="16"/>
                            <TextBlock Text="09:00am" FontSize="14" Foreground="Gray"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Задача 3 -->
                <Border MouseLeftButtonDown="Task_Click" BorderBrush="Black" BorderThickness="1" CornerRadius="10" Background="White" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Margin="15">
                        <CheckBox VerticalAlignment="Center" Margin="0,0,15,0" Click="CheckBox_Click">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#FF0090FF"/>
                                    <Setter Property="BorderThickness" Value="3"/>
                                    <Style.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="50"/>
                                        </Style>
                                    </Style.Resources>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="#FFFF5050"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>

                        <!-- Название и дата -->
                        <StackPanel>
                            <TextBlock Text="Read the book Zlatan" FontSize="16"/>
                            <TextBlock Text="09:00am" FontSize="14" Foreground="Gray"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Задача 4 -->
                <Border MouseLeftButtonDown="Task_Click" BorderBrush="Black" BorderThickness="1" CornerRadius="10" Background="White" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Margin="15">
                        <CheckBox VerticalAlignment="Center" Margin="0,0,15,0" Click="CheckBox_Click">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#FF0090FF"/>
                                    <Setter Property="BorderThickness" Value="3"/>
                                    <Style.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="50"/>
                                        </Style>
                                    </Style.Resources>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="#FFFF5050"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>

                        <!-- Название и дата -->
                        <StackPanel>
                            <TextBlock Text="Meet according with design team..." FontSize="16"/>
                            <TextBlock Text="09:00am" FontSize="14" Foreground="Gray"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Задача 5 -->
                <Border MouseLeftButtonDown="Task_Click" BorderBrush="Black" BorderThickness="1" CornerRadius="10" Background="White" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Margin="15">
                        <CheckBox VerticalAlignment="Center" Margin="0,0,15,0" Click="CheckBox_Click">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#FF0090FF"/>
                                    <Setter Property="BorderThickness" Value="3"/>
                                    <Style.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="50"/>
                                        </Style>
                                    </Style.Resources>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="#FFFF5050"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>

                        <!-- Название и дата -->
                        <StackPanel>
                            <TextBlock Text="Meet according with design team..." FontSize="16"/>
                            <TextBlock Text="09:00am" FontSize="14" Foreground="Gray"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Детали задачи -->
        <Border Grid.Row="1" Grid.Column="2" BorderBrush="Black" BorderThickness="1" Background="White" Margin="10,0,10,90" x:Name="TaskDetailsPanel" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <StackPanel Grid.Row="0" Margin="5,5">
                    <Label x:Name="DetailTitle" Content="Заголовок" FontSize="24" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Дата и время -->
                <StackPanel Grid.Row="1" Margin="5,5">
                    <Label x:Name="DetailTime" Content="18:00" FontSize="14" HorizontalAlignment="Left"/>
                    <Label x:Name="DetailDate" Content="01 Января 2022" FontSize="14" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Описание задачи -->
                <StackPanel Grid.Row="2" Margin="5,5">
                    <Label x:Name="DetailDescription" Content="Lorem ipsum dolor sit amet,&#xD;&#xA;consectetur adipiscing." FontSize="16" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Кнопки Готово и Удалить -->
                <StackPanel Grid.Row="4" Orientation="Vertical" HorizontalAlignment="Center" Margin="5,5">
                    <Button Content="Готово" Click="Button_Click" FontSize="20" Width="240" Height="45" BorderBrush="{x:Null}" Background="#FFFF5050" Foreground="White" Margin="0,0,0,5">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="17"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Удалить" Click="Button_Click1" FontSize="20" Width="240" Height="45" BorderBrush="{x:Null}" Background="#FFFF5050" Foreground="White">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="17"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</Window>