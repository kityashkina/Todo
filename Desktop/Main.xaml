<Window x:Class="Desktop.Main"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Desktop"
        mc:Ignorable="d"
        Title="Main" Height="600" Width="800" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Background="White" Height="100">
            <Image Height="80" Width="80" Margin="10,10,0,10" Source="/ForMenu.png"/>
            <Button Content="Дом" Margin="50,0,0,0" VerticalAlignment="Center" Background="{x:Null}" Foreground="#FF2CCE00" BorderBrush="{x:Null}" FontSize="18"/>
            <Button Content="Работа" Margin="20,0,0,0" VerticalAlignment="Center" Background="{x:Null}" Foreground="#FFFF7500" BorderBrush="{x:Null}" FontSize="18"/>
            <Button Content="Учеба" Margin="20,0,0,0" VerticalAlignment="Center" Background="{x:Null}" Foreground="#FF0045CE" BorderBrush="{x:Null}" FontSize="18"/>
            <Button Content="Отдых" Margin="20,0,0,0" VerticalAlignment="Center" Background="{x:Null}" Foreground="#FFBA00CE" BorderBrush="{x:Null}" FontSize="18"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Width="150">
            <TextBlock Text="Alex" Margin="20,20,0,0" FontSize="18"/>
            <Button Content="Задачи" Margin="20,30,0,0" Background="{x:Null}" BorderBrush="{x:Null}" FontSize="18" HorizontalAlignment="Left"/>
            <Button Content="История" Margin="20,10,0,0" Background="{x:Null}" BorderBrush="{x:Null}" FontSize="18" HorizontalAlignment="Left"/>
            <Button Content="+" Margin="20,250,20,0" Height="70" Width="70" Foreground="White" FontSize="24" BorderBrush="{x:Null}" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFFF5050">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="50"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>

        <!-- Список задач (пункт 4) - ЗДЕСЬ БУДЕТ SCROLLVIEWER С ЗАДАЧАМИ -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <!-- Сюда добавим ItemsControl с задачами -->
        </ScrollViewer>

        <!-- Детали задачи (пункт 5) - ЗДЕСЬ БУДЕТ ОПИСАНИЕ ВЫБРАННОЙ ЗАДАЧИ -->
        <Border Grid.Row="1" Grid.Column="2" Background="White" Margin="10">
            <!-- Сюда добавим детали задачи и кнопки -->
        </Border>

    </Grid>
</Window>